# ---------------------------------------------------------------------------
# Dhaka Kabab — environment template. Copy to .env.local and fill in real
# values. Never commit a populated .env file.
#
# Precedence, from `@next/env`: the shell's own environment first, then
# .env.<mode>.local, .env.local, .env.<mode>, .env — and the *first* definition of a
# key wins. A line here that a higher-priority file repeats as `KEY=` therefore
# switches that capability off, which `npm run env:check` reports by name without
# printing any value.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local instance created by `npm run db:local:start` (127.0.0.1:55432, trust auth).
# Point this at a managed PostgreSQL provider (Neon, Supabase, RDS) in production.
DATABASE_URL="postgresql://dhaka_kabab@127.0.0.1:55432/dhaka_kabab?schema=public"

# Dedicated database for integration + end-to-end tests. Never production.
TEST_DATABASE_URL="postgresql://dhaka_kabab@127.0.0.1:55432/dhaka_kabab_test?schema=public"

# --- App -------------------------------------------------------------------
# Absolute, publicly reachable origin. Used for QR links, gateway callbacks and
# notification links. Must match the deployed host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signed session cookie secret. Generate with: openssl rand -base64 32
# (or `npm run env:check`, which reports whether it is present).
AUTH_SECRET=""

# How often staff/kitchen screens refresh order state (ms). Minimum 1000.
NEXT_PUBLIC_REALTIME_POLL_INTERVAL_MS="2500"

# Where uploaded menu images are written (server side only).
UPLOAD_DIR="./storage/uploads"

# --- Network topology ------------------------------------------------------
# How many proxies stand between a customer and `next start` — 0 when the Node
# process is exposed directly, 1 behind nginx/Caddy on the same box, 2 behind a CDN
# plus an origin proxy. This is the only thing that makes `X-Forwarded-For` usable:
# the leftmost address in that list is written by the client, so the app reads the
# entry its own proxies appended, counted from the right.
#
# 0 (the default) means no forwarded header is believed at all and every request is
# logged as "unknown". Rate limits keyed on the address then share one coarse
# ceiling instead of being per visitor — set this to the real hop count behind a
# proxy, or the limits are honest but blunt.
TRUSTED_PROXY_HOPS="0"

# --- Authentication --------------------------------------------------------
# Session lifetime in seconds. Default 12 hours.
SESSION_MAX_AGE_SECONDS="43200"

# --- AI chatbot ------------------------------------------------------------
# Any OpenAI-compatible endpoint. Left blank, the chatbot runs in the
# clearly-labelled grounded FAQ fallback instead of pretending to be a model.
AI_PROVIDER=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""
AI_API_KEY=""
AI_MAX_OUTPUT_TOKENS="400"
AI_REQUEST_TIMEOUT_MS="20000"

# --- Payment gateway (SSLCommerz) -----------------------------------------
# Without both values online payment is simply unavailable: guests are pointed at
# the counter and staff record the payment against the bill. The simulated gateway
# below is the only way to take an "online" payment without credentials, and it
# never claims real money arrived.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_API_KEY=""
# "sandbox" | "live"
SSLCOMMERZ_MODE="sandbox"
# Override the gateway host only if SSLCommerz gives you a different endpoint.
# Defaults to https://securepay.sslcommerz.com in live mode and
# https://sandbox.sslcommerz.com otherwise.
SSLCOMMERZ_BASE_URL=""

# --- Simulated gateway -----------------------------------------------------
# A stand-in bank for development and for the end-to-end suite. It records payments
# flagged as simulated and separates them from real takings in every report.
# Off unless set, because a button that pretends money moved has no place on a
# live till. Set it to 1 in this file only; leave it unset in production.
ALLOW_SIMULATED_GATEWAY=""

# --- Email notifications ---------------------------------------------------
# Optional. Without SMTP_HOST, notifications are recorded as QUEUED/SKIPPED and
# the UI never claims that an email was delivered.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# --- Seeding / first owner --------------------------------------------------
# `npm run admin:create` reads the three ADMIN_* values below and refuses to run
# without them. There is no default password anywhere in this repository, and
# nothing here ever prints a credential.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# `npm run db:seed` creates settings, menu, floor tables and demo-flagged
# history. It creates no accounts and therefore no password unless this is set;
# when set, it must pass the same strength rules the signup form uses.
SEED_DEMO_PASSWORD=""
# The seed refuses to write to a production database unless this is 1, because
# everything it generates is demo content.
SEED_ALLOW_PRODUCTION="0"

# --- End-to-end tests (local only) ------------------------------------------
# The Playwright staff journey signs in through /login with these. Point them at
# a local development account created by `npm run admin:create`; never put a
# real credential here, this file is copied into a populated .env.
E2E_OWNER_EMAIL=""
E2E_OWNER_PASSWORD=""
